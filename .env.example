# Discord
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-client-id
# Optional: set to a guild ID while developing so slash commands register instantly.
# Leave blank to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials
# > OAuth client ID > "Desktop app" type)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Filled in automatically the first time you run `npm run auth`
GOOGLE_REFRESH_TOKEN=

# Optional: how many Meet links to keep pre-created in the background so
# /meet responds instantly. Default is 5 if unset.
MEETING_POOL_SIZE=5

# Optional: a Discord webhook URL. If set, every meeting created (by anyone,
# anywhere) gets posted here with who created it and the link.
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_LOG_WEBHOOK_URL=
